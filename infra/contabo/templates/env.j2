# Lo escribe infra/contabo/deploy.yml la primera vez y después no lo vuelve a tocar, salvo las
# líneas de dirección, puertos e imagen. Los secretos se generaron al azar en el servidor.

KAORU_PUBLIC_URL=https://{{ kaoru_domain }}
KAORU_HTTPS_PORT=127.0.0.1:{{ kaoru_https_port }}
KEYCLOAK_ADMIN_PORT={{ kaoru_keycloak_admin_port }}

POSTGRES_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', length=32, chars=['ascii_letters', 'digits']) }}
POSTGRES_OWNER_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', length=32, chars=['ascii_letters', 'digits']) }}
POSTGRES_APP_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', length=32, chars=['ascii_letters', 'digits']) }}
KEYCLOAK_DB_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', length=32, chars=['ascii_letters', 'digits']) }}

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', length=24, chars=['ascii_letters', 'digits']) }}

KAORU_OIDC_CLIENT_SECRET={{ lookup('ansible.builtin.password', '/dev/null', length=40, chars=['ascii_letters', 'digits']) }}
OAUTH2_PROXY_COOKIE_SECRET={{ lookup('ansible.builtin.password', '/dev/null', length=32, chars=['ascii_letters', 'digits']) }}

KAORU_API_IMAGE={{ kaoru_api_image }}
