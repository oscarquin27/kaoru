# Valores de LABORATORIO. Copia este archivo a `.env` y cambia todo lo que diga «lab»
# antes de usarlo fuera de una prueba. `.env` nunca se versiona.

# Origen público de la aplicación, sin barra final. Es lo que escribe el usuario en Chrome.
KAORU_PUBLIC_URL=https://localhost:8443
# Puerto del servidor donde escucha Nginx.
KAORU_HTTPS_PORT=8443
# Dónde atiende la consola de administración de Keycloak: solo en el propio servidor.
KEYCLOAK_ADMIN_PORT=8081

POSTGRES_PASSWORD=lab-superusuario
POSTGRES_OWNER_PASSWORD=lab-owner
POSTGRES_APP_PASSWORD=lab-app
KEYCLOAK_DB_PASSWORD=lab-keycloak-db

# Administrador inicial de Keycloak (realm master). Cámbialo y guárdalo según docs/keycloak.md.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=lab-admin

# Secreto del cliente kaoru-web y de la cookie de sesión (esta, exactamente 32 caracteres).
KAORU_OIDC_CLIENT_SECRET=lab-secreto-del-cliente
OAUTH2_PROXY_COOKIE_SECRET=lab-cookie-secreto-de-32-bytes!!

# Opcional: vista previa de Word y Excel dentro de Kaoru. Suma un contenedor grande (unos 2,7 GB).
# Para activarla, quita el «#» de las dos líneas. Sin ellas, esos archivos solo se descargan.
#COMPOSE_PROFILES=office
#KAORU_CONVERTER_URL=http://libreoffice:3000
