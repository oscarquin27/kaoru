{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "boceto",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "tools/boceto"
      ],
      "port": 4173
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web"
      ],
      "port": 5173
    },
    {
      "name": "web-real",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:real",
        "--prefix",
        "web"
      ],
      "port": 5173
    }
  ]
}
